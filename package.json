{
  "name": "zwiedzanie-trzebiatowa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "aplikacje/*",
    "pakiety/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev:gra": "npm run dev --workspace=@zwiedzanie/gra",
    "dev:strona": "npm run dev --workspace=@zwiedzanie/strona",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run build && node --test testy/fundament.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
